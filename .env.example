# Environment Variables — copy to .env and fill in values
# Never commit .env to source control

# ZT Dashboard credentials
EXTENSION_LOGIN_EMAIL=user@example.com
EXTENSION_LOGIN_PASSWORD=your-password-here

# Stable URL of the GPO extension deployment settings page
# The update XML URL and CRX download URL are resolved dynamically from this page at runtime
EXTENSION_DEPLOYMENT_PAGE_URL="https://your-tenant.in.onsquarex.com/enterprise/#/settings/extension-deployment/gpo"

# Dashboard API key (format: id:secret)
DASHBOARD_ACCESS_API=your-key-id:your-key-secret

# Tenant base URL
SQRX_BASE_URL=https://your-tenant.in.onsquarex.com/

# Path to the unpacked extension directory (relative to project root)
EXTENSION_PATH=profiles/extension-unpacked

# Anthropic API key — required for browser-use agent tasks
ANTHROPIC_API_KEY=sk-ant-...

# browser-use behaviour — false for local (headed), true for CI (headless)
BROWSER_USE_HEADLESS=false
